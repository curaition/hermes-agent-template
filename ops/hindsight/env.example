# --- Coolify / Hetzner control plane ---
COOLIFY_URL=https://coolify.<zone>          # instance FQDN (spec D3)
COOLIFY_TOKEN=                              # Coolify → Keys & Tokens → API tokens
HCLOUD_TOKEN=                               # Hetzner Cloud project → Security → API tokens
HCLOUD_SERVER_NAME=                         # as shown in Hetzner console
ADMIN_CIDR=0.0.0.0/0                        # narrow SSH source if your IP is stable, e.g. 1.2.3.4/32
BOX_IP=                                     # public IPv4 of the box (verify.sh nmap target)
# --- Hindsight stack ---
HINDSIGHT_FQDN=hindsight.<zone>
HINDSIGHT_VERSION=                          # pinned tag from ghcr.io/vectorize-io/hindsight (coolify_apply.sh refuses 'latest')
HINDSIGHT_DB_PASSWORD=                      # openssl rand -hex 32
HINDSIGHT_TENANT_API_KEY=                   # openssl rand -hex 32  (== Hermes HINDSIGHT_API_KEY)
HINDSIGHT_LLM_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=                             # AI Studio, NON-product GCP project
OPENAI_API_KEY=                             # embeddings (same key as GBrain service)
# --- backups ---
COOLIFY_S3_STORAGE_UUID=                    # after adding the GCS storage in Coolify UI (Storages → open it → uuid in URL)
