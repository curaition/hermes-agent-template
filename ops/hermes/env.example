# Railway env for the Hermes Agent service — names only, values set in Railway.
# Existing (unchanged): HERMES_GBRAIN_TOKEN, HERMES_MCP_LINEAR_JSON, HERMES_USER_MD, GH_TOKEN, ...
HINDSIGHT_API_URL=<set-me>
HINDSIGHT_API_KEY=<set-me>
HERMES_MEMORY_PROVIDER=hindsight
HERMES_HINDSIGHT_CONFIG_JSON=<b64 of ops/hermes/hindsight.config.json with <zone> substituted>
HERMES_MCP_SERVERS_YAML=<b64 of ops/hermes/mcp_servers.yaml>
# Guardrails ride in SOUL.md (system persona), re-applied every boot. USER.md/HERMES_USER_MD are the agent-written profile — leave them alone.
HERMES_SOUL_MD=<b64 of `bash ops/hermes/render_soul.sh`>
# GitHub App identity (owner swarm Step 1, CUR-1538) — see ops/github-app/README.md. When both are set,
# start.sh and every owner run mint an installation token and the PAT below is never used.
GH_APP_ID=<set-me>
GH_APP_PRIVATE_KEY_B64=<set-me>
# GH_TOKEN: legacy PAT path, fallback only while the App vars are unset (READ-ONLY fine-grained PAT,
# Contents:Read + Metadata:Read + Pull requests:Read on curaition/curaition). Retire after cutover.
GH_TOKEN=<set-me>
# Linear personal API key used by mcp_servers.linear (Bearer header); also lives in /data/.hermes/.env on the volume
LINEAR_API_KEY=<set-me>
