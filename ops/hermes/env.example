# Railway env for the Hermes Agent service — names only, values set in Railway.
# Existing (unchanged): HERMES_GBRAIN_TOKEN, HERMES_MCP_LINEAR_JSON, HERMES_USER_MD, GH_TOKEN, ...
HINDSIGHT_API_URL=<set-me>
HINDSIGHT_API_KEY=<set-me>
HERMES_MEMORY_PROVIDER=hindsight
HERMES_HINDSIGHT_CONFIG_JSON=<b64 of ops/hermes/hindsight.config.json with <zone> substituted>
HERMES_MCP_SERVERS_YAML=<b64 of ops/hermes/mcp_servers.yaml>
HERMES_USER_MD=<b64 of ops/GUARDRAILS.md>
# GH_TOKEN must be the READ-ONLY fine-grained PAT (Contents:Read + Metadata:Read on curaition-xyz/curaition)
GH_TOKEN=<set-me>
